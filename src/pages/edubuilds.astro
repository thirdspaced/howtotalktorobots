---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CopyBlock from '../components/CopyBlock.astro';
import ResourceCard from '../components/ResourceCard.astro';

const library = (await getCollection('library')).filter((e) => !e.data.draft);
const pack = library
  .filter((e) => e.data.topics.includes('edubuilds'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const setup = library.find((e) => e.id === 'classroom-project-setup-guide');
const setupPrompt = setup?.data.prompt ?? '';

const prompts = pack.filter((e) => e.data.type === 'prompt');
const frameworks = pack.filter((e) => e.data.type !== 'prompt');

interface Case {
  id: string;
  title: string;
  kicker: string;
  need: string;
  produced: string[];
  changed: string[];
  learners: string;
  limitation: string;
  transfer: { href: string; label: string };
  links?: { href: string; label: string }[];
}

const cases: Case[] = [
  {
    id: 'gold-rush',
    kicker: 'Case 1',
    title: 'Gold Rush',
    need: 'A San Francisco 1849 unit for seven- and eight-year-old readers around level M, where the biographies feed the play instead of sitting next to it.',
    produced: [
      'An Oregon Trail-style Gold Rush game, built by talking to an LLM and tested with second graders',
      'Group profiles of the 49ers, and biographies of historical figures including Mary Ellen Pleasant and Mifflin Wistar Gibbs',
      'A bingo and scavenger hunt keyed to the biographies, and a Time Traveler field log for the stations',
    ],
    changed: [
      'Every scavenger-hunt question checked against the biography text, so the answer was findable but not obvious',
      'The generated biography pages debugged by hand before any child saw them',
      'Fact, interpretation and game mechanic kept visibly separate, and the cast reviewed for who was missing',
    ],
    learners: 'Learners played one decision at a time, read the biographies to answer the hunt, and said what information they used to choose.',
    limitation:
      'Game rules are invented. A seven-year-old can take an invented rule as history unless the teacher names the difference out loud, every time.',
    transfer: { href: '/library/decision-activity-or-project-support/', label: 'The decision activity prompt and template' },
    links: [{ href: 'https://gold-rush-seven.vercel.app', label: 'Play the Gold Rush game' }],
  },
  {
    id: 'waterways',
    kicker: 'Case 2',
    title: 'Waterways and the city systems unit',
    need: 'A place-based study of the first peoples of the San Francisco area and their relationships with water, for the same readers, inside a unit on how the city works.',
    produced: [
      'Waterways of the First People, an interactive guide with knowledge packets and riddles, and a one-page water connections treasure hunt that sends learners back to it',
      'A landmark design and reflection sheet with systems-thinking prompts, a Tinkercad design check, and a zine creator worksheet',
      'A San Francisco city systems quiz with an answer key',
    ],
    changed: [
      'The first version read like a game. The framing was rewritten around relationships with water, with specific community names and community-authored sources where they exist',
      'Every claim checked for time period, place, attribution and present-day continuity',
      'The field study at Crane Cove became observe, do not collect',
    ],
    learners:
      'Learners authored the systems explanations, the landmark models in Tinkercad and the zines. The AI-assisted pieces were the organizer, the source packet and the design check.',
    limitation:
      'A generated page about living communities needs a human check on every name and claim. The digital material only earns its place when it points learners back to local observation.',
    transfer: { href: '/library/one-source-three-formats/', label: 'One source, several formats, same facts' },
    links: [
      { href: 'https://www.canva.com/d/eaRHLCZ-8QDo329', label: 'SF city systems quiz' },
      { href: 'https://www.canva.com/d/URwL4dDK83D44tl', label: 'Answer key' },
    ],
  },
  {
    id: 'reading-access',
    kicker: 'Case 3',
    title: 'Reading access and daily word work',
    need: 'Learners reading around level L who still need to explain the relationship between a place and its water system, plus daily word work for learners with IEPs and a research project comparing myths with informational texts.',
    produced: [
      'Customized reading passages and comprehension scaffolds, with the learning target held fixed',
      'Practice sets for ch and tch, ge and dge, long and short vowels, and homophones',
      'A research poster organizer, an independent poster guide and a model poster, plus a five-minute reading check-in',
    ],
    changed: [
      'The science sources that came back too advanced for level L readers were replaced with a simpler set, each one checked against the readers it was for',
      'Every practice word checked against the taught patterns; a model’s reading-level label treated as a guess, never as validation',
      'Barriers described as observed; diagnoses kept out of the prompt entirely',
    ],
    learners:
      'The reading project ended in art, a written response and a recorded reading. The word work ran daily, from checked sets.',
    limitation:
      'Access to content and decoding practice are different design tasks. A prompt that blurs them produces a text that is neither.',
    transfer: { href: '/library/adapt-a-reading-passage/', label: 'The reading access prompt' },
  },
];

const costs = [
  { task: 'Generated biography pages for the 1849 unit', status: 'Not responding', instead: 'Debugged by hand; hunt questions tied to text I had checked' },
  { task: 'Science sources for the reading project', status: 'Too advanced', instead: 'Replaced with a simpler set, each checked against level L readers' },
  { task: 'The first Waterways framing', status: 'Distorting the purpose', instead: 'Reframed around relationships with water, with named communities and their sources' },
  { task: '“Second-grade reading level” labels', status: 'Unverified', instead: 'Treated as a guess; words checked against the taught patterns' },
];

const alsoAtSummit = [
  { who: 'Kanishka Seth', what: 'step-by-step AI instructions on the assignments you already have' },
  { who: 'Angela Chen', what: 'which model actually sits behind a classroom tool, and how to vet it' },
  { who: 'Azade Sanjari', what: 'hint ladders and help that does not do the thinking' },
  { who: 'Tiffany Wong', what: 'K-5 inclusive design with AI, grounded in UDL' },
  { who: 'April Lehman, Anuja Agarwal and Natasha McKeown', what: 'NotebookLM as a source-grounded notebook for learning and school communication' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'What survived the classroom: real AI builds, tools and practices for educators',
    description:
      'Three classroom builds made with LLMs, what the teacher had to change before each one worked, and the free setup guide, build card and prompt set from the Khan Lab School AI in Education Summit session.',
    author: { '@type': 'Person', name: 'Amanda Grutza' },
    datePublished: '2026-10-24',
  },
];
---

<Base
  title="Edu builds · What survived the classroom · how to talk to robots"
  description="Three classroom AI builds, what the teacher had to change before each one worked, and the free setup guide, build card and prompts from the Khan Lab School AI in Education Summit session."
  schema={schema}
>
  <article class="prose section">
    <p class="kicker">Edu builds</p>
    <h1>What survived the classroom</h1>
    <p style="font-size: var(--text-lg); color: var(--ink-soft);">
      Real AI builds, tools and practices for educators, from a year of building classroom
      materials with LLMs for a second-grade reading group and enrichment classes in San
      Francisco. Presented at the Khan Lab School AI in Education Summit, October 24, 2026.
      Everything on this page is free to copy, adapt and share.
    </p>
    <p class="cta-row">
      <a class="button" href="/library/classroom-project-setup-guide/">Start with the setup guide</a>
      <a class="button secondary" href="#prompts">Jump to the prompts</a>
    </p>

    <h2>The short version</h2>
    <p>
      Over one school year I built 133 things with LLMs for one classroom: word study for
      learners with IEPs, customized reading passages, scaffolded comprehension tools,
      goal-setting chatbots, project guides, progress notes, full units. Three of those
      builds are worth your time, and every one of them needed a teacher to change
      something before it worked with children. That change is the content of this page.
    </p>
    <p>
      Nothing here needs a specific tool. Use whatever your school has approved, and if
      your students cannot have accounts yet, the pattern still holds: the teacher prepares
      and demonstrates, the students read, discuss, design, test and make.
    </p>
  </article>

  <section class="wrap" aria-labelledby="start-heading" style="margin-top: 2rem;">
    <div class="section-head">
      <h2 id="start-heading">Start here</h2>
    </div>
    <div class="grid-3">
      <article class="card guide-card">
        <h3><a href="/library/classroom-project-setup-guide/">The setup guide</a></h3>
        <ul>
          <li>Set up a project space once, in any approved tool</li>
          <li>One instruction block, one context card</li>
          <li>What goes in and what never does</li>
        </ul>
        <a class="card-link" href="/library/classroom-project-setup-guide/">Read the setup guide</a>
      </article>
      <article class="card guide-card">
        <h3><a href="/library/classroom-build-card/">The build card</a></h3>
        <ul>
          <li>Twelve minutes from a source to a checked draft</li>
          <li>Three pathways: reading access, decision activity, project support</li>
          <li>A definition of ready</li>
        </ul>
        <a class="card-link" href="/library/classroom-build-card/">Get the build card</a>
      </article>
      <article class="card guide-card">
        <h3><a href="/library/peer-review-card-and-trial-log/">Review and trial</a></h3>
        <ul>
          <li>Five questions a colleague runs on your draft</li>
          <li>A one-lesson trial log</li>
          <li>The exit slip</li>
        </ul>
        <a class="card-link" href="/library/peer-review-card-and-trial-log/">Get the review card</a>
      </article>
    </div>
  </section>

  <article class="prose section">
    <h2>The instruction block, if you only take one thing</h2>
    <p>
      Paste this into the instructions of a project, Gem or notebook in whatever tool your
      school has approved. Fill in the square brackets. The last two sentences are the
      ones that matter.
    </p>
    <CopyBlock text={setupPrompt.trim()} label="Copy the instruction block" />
    <p style="font-size: var(--text-sm); color: var(--ink-soft);">
      The full setup, including the context card and the two lists of what goes in and
      what never does, is in <a href="/library/classroom-project-setup-guide/">the setup guide</a>.
    </p>
  </article>

  <section class="wrap section" aria-labelledby="cases-heading">
    <div class="section-head">
      <h2 id="cases-heading">Three builds, and what had to change</h2>
    </div>
    <p class="prose-note">
      Each case is told the same way: the classroom need, what AI helped produce, what the
      teacher changed, what learners did, what transfers, and one honest limitation.
    </p>
    <div class="cases">
      {cases.map((c) => (
        <article class="card case" id={c.id}>
          <p class="kicker">{c.kicker}</p>
          <h3>{c.title}</h3>
          <dl>
            <dt>The classroom need</dt>
            <dd>{c.need}</dd>
            <dt>What AI helped produce</dt>
            <dd><ul>{c.produced.map((p) => <li>{p}</li>)}</ul></dd>
            <dt>What the teacher changed</dt>
            <dd><ul>{c.changed.map((p) => <li>{p}</li>)}</ul></dd>
            <dt>What learners did</dt>
            <dd>{c.learners}</dd>
            <dt>What transfers</dt>
            <dd><a href={c.transfer.href}>{c.transfer.label}</a></dd>
            <dt>One honest limitation</dt>
            <dd>{c.limitation}</dd>
          </dl>
          {c.links && (
            <p class="case-links">
              {c.links.map((l) => (
                <a class="chip" href={l.href} rel="noopener">{l.label} <span aria-hidden="true">↗</span></a>
              ))}
            </p>
          )}
        </article>
      ))}
    </div>
  </section>

  <article class="prose section">
    <h2>The same five questions for every build</h2>
    <p>
      This is the process behind the case cards, and the fields on the build card. Run it on
      anything you will reuse, share or hand to another adult. A one-off morning message
      does not need it.
    </p>
    <ol class="steps">
      <li><h3>What was the classroom need?</h3><p>A real task, a learner barrier or a missing resource.</p></li>
      <li><h3>What did AI help produce?</h3><p>The original draft or build, the prompt, and the source it used.</p></li>
      <li><h3>What did the teacher change?</h3><p>A visible correction, revision or design decision. This is where the value is.</p></li>
      <li><h3>What did learners actually do?</h3><p>A de-identified work sample or a specific observation. Engagement, completion, understanding and independence are four different things; say which one you saw.</p></li>
      <li><h3>What can another teacher transfer?</h3><p>A small template and a check for readiness. Plus one honest limitation.</p></li>
    </ol>

    <h2>Where the LLM cost more than it saved</h2>
    <p>Four places from my own record, and what I did instead.</p>
    <table class="costs">
      <thead>
        <tr><th scope="col">Task</th><th scope="col">Status</th><th scope="col">What I did instead</th></tr>
      </thead>
      <tbody>
        {costs.map((row) => (
          <tr>
            <td>{row.task}</td>
            <td class="status">{row.status}</td>
            <td>{row.instead}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>
      <strong>Ready</strong> means: the key claims are checked, the task matches the learning
      goal, the supports fit the barrier, and you can say what evidence you will look for.
      One lesson then tests the resource. It does not prove a learning gain.
    </p>
  </article>

  <section class="wrap section" aria-labelledby="prompts-heading" id="prompts">
    <div class="section-head">
      <h2 id="prompts-heading">The prompts</h2>
      <a href="/library/">Browse the whole library</a>
    </div>
    <p class="prose-note">
      Every prompt ends by asking the model what you should check before using the draft
      with children. Keep that line when you adapt them.
    </p>
    <div class="grid-3">
      {prompts.map((entry) => <ResourceCard entry={entry} />)}
    </div>
    <div class="section-head" style="margin-top: 2rem;">
      <h2 id="frameworks-heading">The cards</h2>
    </div>
    <div class="grid-3">
      {frameworks.map((entry) => <ResourceCard entry={entry} />)}
    </div>
  </section>

  <article class="prose section">
    <h2>Getting an account</h2>
    <p>
      If you teach K-12 in the United States, both
      <a href="https://www.anthropic.com/news/claude-for-teachers" rel="noopener">Claude for Teachers</a>
      and
      <a href="https://openai.com/index/chatgpt-for-teachers/" rel="noopener">ChatGPT for Teachers</a>
      are free individual sign-ups for verified educators. Your school does not need to
      enroll. Check your district's guidance on which tools are approved for planning before
      you build, and keep student data out of all of them (the setup guide covers how).
    </p>

    <h2>Also at the summit</h2>
    <p>
      This session left several things out on purpose, because other presenters at the
      <a href="https://khanlabschool.org/AIED-sessions" rel="noopener">Khan Lab School AI in Education Summit</a>
      covered them better than 45 minutes could:
    </p>
    <ul>
      {alsoAtSummit.map((s) => (
        <li><strong>{s.who}</strong> on {s.what}.</li>
      ))}
    </ul>

    <div class="draft-note">
      <strong>Coming to this page.</strong> The slide deck once it is final, a guide to making
      a classroom game with an LLM (the spec-first method from the Gold Rush build), the prep
      method behind the session, and the full prompt library. Check back after the summit,
      or <a href="/contact/">ask to be told when it lands</a>.
    </div>

    <h2>Bring this to your school</h2>
    <p>
      I run this as a hands-on workshop for schools and teams: real builds, a twelve-minute
      build block, peer review, and a trial plan everyone leaves with.
      <a href="/contact/">Get in touch</a>. And if you have a build that survived your own
      classroom, <a href="/contribute/">send it in</a>. This library grows by what teachers
      actually used.
    </p>
  </article>
</Base>

<style>
  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brick);
    margin: 0 0 0.35rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.25rem 0 0.5rem;
  }
  .prose-note {
    color: var(--ink-soft);
    margin: 0 0 1.1rem;
  }
  .cases {
    display: grid;
    gap: 1.25rem;
  }
  .case h3 {
    margin-bottom: 0.9rem;
  }
  .case dl {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: 0.5rem 1.25rem;
    margin: 0;
  }
  .case dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-top: 0.2rem;
  }
  .case dd {
    margin: 0;
    font-size: var(--text-sm);
    max-width: var(--measure);
  }
  .case dd ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .case dd li + li {
    margin-top: 0.25rem;
  }
  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
  }
  .costs {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    margin: 1rem 0 1.25rem;
  }
  .costs th,
  .costs td {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.6rem;
    border-bottom: 1px solid var(--card-line);
  }
  .costs th {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 700;
  }
  .costs .status {
    color: var(--brick);
    font-weight: 500;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .case dl {
      grid-template-columns: 1fr;
      gap: 0.15rem 0;
    }
    .case dd {
      margin-bottom: 0.6rem;
    }
    .costs .status {
      white-space: normal;
    }
  }
</style>
