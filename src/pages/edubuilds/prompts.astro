---
import Base from '../../layouts/Base.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import prompts from '../../data/educator-prompts.json';

interface Prompt {
  no: number;
  category: string;
  title: string;
  text: string;
}

const all = prompts as Prompt[];

const categoryNotes: Record<string, string> = {
  'A. Project setup and reusable context':
    'Set up once, reuse everywhere. Start with 01 and 02 (or the fuller version on the teaching thought partner page), then use 03 to 07 at the start of each new piece of work.',
  'B. Spoken ideas, research, and planning':
    'From a voice memo or a half-formed idea to a checked plan. 11 and 12 are research briefs written for a search-grounded tool such as Perplexity; 14 is written for Gemini.',
  'C. Adaptation and classroom artifacts':
    'The biggest set. Supported and stretch versions, decodable practice, worksheets and booklets, decision games, student-facing sites, slides, quizzes, Kahoot imports, audio and video explainers, and a final review before export.',
  'D. Bulk data analysis and transfer':
    'One careful prompt for spreadsheets. Fictional, non-sensitive or institution-approved inputs only.',
  'E. Newsletters and optional home connections':
    'Family-facing writing from a confirmed recap, in your voice, with no invented reactions, outcomes or quotes.',
  'F. Personal assistants and administrative follow-through':
    'Assistant prompts that draft and organize but never send, schedule, purchase or delete without your explicit say-so.',
  'G. Student-note demonstration':
    'A fictional documentation demonstration. Structure an observation without inventing motives, diagnoses or labels.',
  'H. Independent student projects':
    'Planning partner instructions for project-based courses, a profile to make them yours, and a session planner.',
};

const categories = [...new Set(all.map((p) => p.category))];
const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/^[a-z]\.\s*/, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const label = (s: string) => s.replace(/^[A-Z]\.\s*/, '');
const pad = (n: number) => String(n).padStart(2, '0');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Educator AI master prompts',
    description:
      '54 copy-paste prompts for teachers, grouped by task: project setup, planning and research, adaptation and classroom artifacts, data, family newsletters, admin follow-through, student notes and independent projects.',
    numberOfItems: all.length,
    itemListElement: all.map((p) => ({ '@type': 'ListItem', position: p.no, name: p.title })),
  },
];
---

<Base
  title="54 educator AI prompts · Edu builds · how to talk to robots"
  description="The full prompt library behind What Survived the Classroom: 54 copy-paste prompts for planning, adapting, making classroom materials, writing family newsletters and running independent projects, each one ending with what the teacher should check."
  schema={schema}
>
  <article class="prose section">
    <nav aria-label="Breadcrumb" style="font-size: var(--text-sm); margin-bottom: 1rem;">
      <a href="/edubuilds/">← Back to Edu builds</a>
    </nav>
    <p class="kicker">Edu builds</p>
    <h1>The educator AI prompt library</h1>
    <p style="font-size: var(--text-lg); color: var(--ink-soft);">
      {all.length} prompts in eight groups, from setting up a planning partner to writing the
      family newsletter. Every one of them assumes you make the final call, works from your
      own files, and ends by telling you what to check.
    </p>
    <p>
      Replace anything in square brackets with your own context. Most prompts expect the
      <a href="/library/teaching-thought-partner-setup/">teaching thought partner setup</a>
      to be in place first, so the model already knows your class and your rules. Prompts
      written for a specific tool say so in their title.
    </p>
    <p class="cta-row">
      <a class="button secondary" href="/edubuilds/Educator_AI_Master_Prompts.xlsx" download>Download the spreadsheet (.xlsx)</a>
    </p>
    <ul class="chips groups" aria-label="Prompt groups">
      {categories.map((c) => (
        <li><a class="chip" href={`#${slug(c)}`}>{label(c)}</a></li>
      ))}
    </ul>
  </article>

  {categories.map((c) => {
    const items = all.filter((p) => p.category === c);
    return (
      <section class="prose section group" id={slug(c)} aria-labelledby={`${slug(c)}-heading`}>
        <p class="kicker">{items.length} {items.length === 1 ? 'prompt' : 'prompts'}</p>
        <h2 id={`${slug(c)}-heading`}>{label(c)}</h2>
        {categoryNotes[c] && <p class="prose-note">{categoryNotes[c]}</p>}
        {items.map((p) => (
          <div class="prompt" id={`prompt-${pad(p.no)}`}>
            <h3><span class="num">{pad(p.no)}</span> {p.title}</h3>
            <CopyBlock text={p.text.trim()} />
          </div>
        ))}
        <p class="back"><a href="#main">Back to the top</a></p>
      </section>
    );
  })}

  <article class="prose section">
    <h2>How these were made</h2>
    <p>
      These prompts came out of a year of building classroom materials with LLMs for a
      second-grade reading group and enrichment classes in San Francisco, then cleaning up
      what survived. The three cases behind them, and what had to change before each was
      usable, are on the <a href="/edubuilds/">Edu builds</a> page. Anything students,
      families or colleagues will read gets a pass with the
      <a href="/library/tone-and-voice-style-guide-for-educators/">tone and voice style guide</a>
      first.
    </p>
    <p>
      Free to use and share. Have a prompt that survived your own classroom?
      <a href="/contribute/">Send it in</a>.
    </p>
  </article>
</Base>

<style>
  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brick);
    margin: 0 0 0.35rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1rem 0 1.25rem;
  }
  .groups {
    justify-content: flex-start;
    max-width: none;
    margin: 0;
  }
  .prose-note {
    color: var(--ink-soft);
  }
  .group {
    padding-top: 1.5rem;
    border-top: 1px solid var(--card-line);
    margin-top: 1.5rem;
  }
  .prompt {
    margin-top: 1.75rem;
  }
  .prompt h3 {
    margin-bottom: 0.25rem;
  }
  .num {
    display: inline-block;
    min-width: 2.2rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--brick);
    vertical-align: middle;
  }
  .back {
    font-size: var(--text-sm);
    margin-top: 1.5rem;
  }
</style>
