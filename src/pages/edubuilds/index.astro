---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import ResourceCard from '../../components/ResourceCard.astro';

const library = (await getCollection('library')).filter((e) => !e.data.draft);
const pack = library
  .filter((e) => e.data.topics.includes('edubuilds'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const setup = library.find((e) => e.id === 'classroom-project-setup-guide');
const setupPrompt = setup?.data.prompt ?? '';

const prompts = pack.filter((e) => e.data.type === 'prompt');
const frameworks = pack.filter((e) => e.data.type !== 'prompt');

interface Case {
  id: string;
  title: string;
  kicker: string;
  need: string;
  produced: string[];
  changed: string[];
  learners: string;
  watch: string;
  transfer: { href: string; label: string };
  links?: { href: string; label: string; internal?: boolean }[];
}

const cases: Case[] = [
  {
    id: 'gold-rush',
    kicker: 'Case 1',
    title: 'Gold Rush',
    need: 'A San Francisco 1849 unit for seven- and eight-year-olds reading around level M, with the biographies built into the play.',
    produced: [
      'An Oregon Trail-style game, built by talking to an LLM and tested with second graders',
      'Group profiles of the 49ers and biographies of people like Mary Ellen Pleasant and Mifflin Wistar Gibbs',
      'A bingo, a scavenger hunt keyed to the biographies, and a Time Traveler field log for the stations',
    ],
    changed: [
      'Checked every scavenger-hunt question against the biography text',
      'Debugged the generated biography pages by hand before any child saw them',
      'Kept fact, interpretation and game rule visibly separate, and reviewed the cast for who was missing',
    ],
    learners: 'Played one decision at a time, read the biographies to answer the hunt, and said what information they used to choose.',
    watch: 'Game rules are invented. Say so out loud every time, or a seven-year-old will remember them as history.',
    transfer: { href: '/library/decision-activity-or-project-support/', label: 'The decision activity prompt and template' },
    links: [
      { href: 'https://gold-rush-seven.vercel.app', label: 'Play the Gold Rush game' },
      { href: '/library/build-your-own-historical-game/', label: 'How the game was built', internal: true },
    ],
  },
  {
    id: 'waterways',
    kicker: 'Case 2',
    title: 'Waterways and the city systems unit',
    need: 'A place-based study of the first peoples of the San Francisco area and their relationships with water, for the same readers, inside a unit on how the city works.',
    produced: [
      'Waterways of the First People, an interactive guide with knowledge packets and riddles, plus a one-page water connections treasure hunt that sends learners back to it',
      'A landmark design and reflection sheet with systems-thinking prompts, a Tinkercad design check and a zine worksheet',
      'A San Francisco city systems quiz with an answer key',
    ],
    changed: [
      'Rewrote the first version, which read like a game, around relationships with water, with specific community names and community-authored sources where they exist',
      'Checked every claim for time period, place, attribution and whether the community is described in the present tense',
      'Changed the Crane Cove field study to observe only, no collecting',
    ],
    learners: 'Wrote the systems explanations, built the landmark models in Tinkercad and made the zines. AI helped with the organizer, the source packet and the design check.',
    watch: 'A generated page about living communities needs a human check on every name and claim. The digital pieces are there to send learners back outside to look.',
    transfer: { href: '/library/one-source-three-formats/', label: 'One source, four formats, the same facts' },
    links: [
      { href: 'https://www.canva.com/d/eaRHLCZ-8QDo329', label: 'SF city systems quiz' },
      { href: 'https://www.canva.com/d/URwL4dDK83D44tl', label: 'Answer key' },
    ],
  },
  {
    id: 'reading-access',
    kicker: 'Case 3',
    title: 'Reading access and daily word work',
    need: 'Learners reading around level L who still need to explain how a place and its water system are connected, daily word work for learners with IEPs, and a research project comparing myths with informational texts.',
    produced: [
      'Customized reading passages and comprehension scaffolds, with the learning target unchanged',
      'Practice sets for ch and tch, ge and dge, long and short vowels, and homophones',
      'A research poster organizer, an independent poster guide, a model poster and a five-minute reading check-in',
    ],
    changed: [
      'Replaced the science sources that came back too hard for level L readers with a simpler set, each one checked against the readers it was for',
      'Checked every practice word against the taught patterns, and treated the model’s reading-level label as a guess',
      'Described barriers as observed and kept diagnoses out of the prompt',
    ],
    learners: 'The reading project ended in art, a written response and a recorded reading. The word work ran daily from checked sets.',
    watch: 'Access to content and decoding practice are two different jobs. A prompt that mixes them gives you a text that does neither well.',
    transfer: { href: '/library/adapt-a-reading-passage/', label: 'The reading access prompt' },
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'What survived the classroom: real AI builds, tools and practices for educators',
    description:
      'Prompts, guides and three classroom builds from a year of making materials with LLMs for a second-grade reading group and enrichment classes, from the Khan Lab School AI in Education Summit session.',
    author: { '@type': 'Person', name: 'Amanda Grutza' },
    datePublished: '2026-10-24',
  },
];
---

<Base
  title="Edu builds · What survived the classroom · how to talk to robots"
  description="Prompts, guides and three classroom builds from a year of making materials with LLMs for a second-grade reading group and enrichment classes, from the Khan Lab School AI in Education Summit session."
  schema={schema}
>
  <article class="prose section">
    <p class="kicker">Edu builds</p>
    <h1>What survived the classroom</h1>
    <p style="font-size: var(--text-lg); color: var(--ink-soft);">
      Prompts, guides and three classroom builds from a year of making materials with LLMs
      for a second-grade reading group and enrichment classes in San Francisco. From my
      session at the Khan Lab School AI in Education Summit, October 24, 2026. Free to copy,
      adapt and share.
    </p>
    <p class="cta-row">
      <a class="button" href="/library/teaching-thought-partner-setup/">Start with the setup</a>
      <a class="button secondary" href="/edubuilds/prompts/">All 54 prompts</a>
    </p>

    <h2>The short version</h2>
    <p>
      Here are over 100 resources built for a few classroom domains: word study for learners
      with IEPs, customized reading passages, scaffolded comprehension tools, goal-setting
      chatbots, project guides, progress notes, and full unit outlines.
    </p>
    <p>
      None of these prompts or guides require a specific tool, use whatever your school has
      approved.
    </p>
  </article>

  <section class="wrap" aria-labelledby="start-heading" style="margin-top: 2rem;">
    <div class="section-head">
      <h2 id="start-heading">Start here</h2>
    </div>
    <div class="grid-3">
      <article class="card guide-card">
        <h3><a href="/library/teaching-thought-partner-setup/">The teaching thought partner setup</a></h3>
        <ul>
          <li>A Quick Start to paste into a Project or Gem in five minutes</li>
          <li>A Teaching Profile for when you have twenty</li>
          <li>What to upload, what to keep out, and how to test it</li>
        </ul>
        <a class="card-link" href="/library/teaching-thought-partner-setup/">Set up your planning partner</a>
      </article>
      <article class="card guide-card">
        <h3><a href="/library/classroom-build-card/">The build card</a></h3>
        <ul>
          <li>Twelve minutes from a source to a draft you've checked</li>
          <li>Three pathways: reading access, decision activity, project support</li>
          <li>What ready means</li>
        </ul>
        <a class="card-link" href="/library/classroom-build-card/">Get the build card</a>
      </article>
      <article class="card guide-card">
        <h3><a href="/library/peer-review-card-and-trial-log/">Review and trial</a></h3>
        <ul>
          <li>Five questions a colleague runs on your draft</li>
          <li>A one-lesson trial log</li>
          <li>The exit slip</li>
        </ul>
        <a class="card-link" href="/library/peer-review-card-and-trial-log/">Get the review card</a>
      </article>
    </div>
  </section>

  <article class="prose section">
    <h2>The one-paragraph setup</h2>
    <p>
      Paste this into the instructions of a Project, Gem or notebook in whatever tool your
      school has approved, and fill in the brackets. Keep the last two sentences as they are.
    </p>
    <CopyBlock text={setupPrompt.trim()} label="Copy the instruction block" />
    <p style="font-size: var(--text-sm); color: var(--ink-soft);">
      The full <a href="/library/teaching-thought-partner-setup/">teaching thought partner setup</a>
      adds file checks, a style pass and a teacher check at the end of every resource. The
      <a href="/library/classroom-project-setup-guide/">one-paragraph guide</a> covers what to
      upload and what to keep out.
    </p>
  </article>

  <section class="wrap section" aria-labelledby="cases-heading">
    <div class="section-head">
      <h2 id="cases-heading">Three builds, and what had to change</h2>
    </div>
    <div class="cases">
      {cases.map((c) => (
        <article class="card case" id={c.id}>
          <p class="kicker">{c.kicker}</p>
          <h3>{c.title}</h3>
          <dl>
            <dt>The classroom need</dt>
            <dd>{c.need}</dd>
            <dt>What AI helped make</dt>
            <dd><ul>{c.produced.map((p) => <li>{p}</li>)}</ul></dd>
            <dt>What I changed</dt>
            <dd><ul>{c.changed.map((p) => <li>{p}</li>)}</ul></dd>
            <dt>What learners did</dt>
            <dd>{c.learners}</dd>
            <dt>Take this with you</dt>
            <dd><a href={c.transfer.href}>{c.transfer.label}</a></dd>
            <dt>Watch for</dt>
            <dd>{c.watch}</dd>
          </dl>
          {c.links && (
            <p class="case-links">
              {c.links.map((l) => (
                <a class="chip" href={l.href} rel={l.internal ? undefined : 'noopener'}>
                  {l.label}{!l.internal && <span aria-hidden="true"> ↗</span>}
                </a>
              ))}
            </p>
          )}
        </article>
      ))}
    </div>
  </section>

  <article class="prose section">
    <h2>Five questions for every build</h2>
    <p>
      These are the fields on the build card and the way each case above is written up. Use
      them for anything you'll reuse, share or hand to another adult. A one-off morning
      message doesn't need them.
    </p>
    <ol class="steps">
      <li><h3>What was the classroom need?</h3><p>A real task, a learner barrier or a missing resource.</p></li>
      <li><h3>What did AI help make?</h3><p>The draft or build, the prompt, and the source it used.</p></li>
      <li><h3>What did the teacher change?</h3><p>A correction, a revision or a design decision you can point to.</p></li>
      <li><h3>What did learners do?</h3><p>A de-identified work sample or a specific observation. Engagement, completion, understanding and independence are four different things, so say which one you saw.</p></li>
      <li><h3>What can another teacher take?</h3><p>A small template, a readiness check, and the limitation you found.</p></li>
    </ol>
  </article>

  <section class="wrap section" aria-labelledby="prompts-heading" id="prompts">
    <div class="section-head">
      <h2 id="prompts-heading">The prompts from the session</h2>
      <a href="/edubuilds/prompts/">See all 54 prompts</a>
    </div>
    <p class="prose-note">
      Every prompt ends by asking the model what you should check before using the draft
      with children. Keep that line when you adapt them.
    </p>
    <div class="grid-3">
      {prompts.map((entry) => <ResourceCard entry={entry} />)}
    </div>
    <div class="section-head" style="margin-top: 2rem;">
      <h2 id="frameworks-heading">The guides and cards</h2>
    </div>
    <div class="grid-3">
      {frameworks.map((entry) => <ResourceCard entry={entry} />)}
    </div>
  </section>

  <article class="prose section">
    <h2>The full prompt library</h2>
    <p>
      Fifty-four prompts in eight groups: project setup, spoken ideas and research,
      adaptation and classroom artifacts, bulk data, family newsletters, admin
      follow-through, student notes, and independent student projects. Each one works from
      your own files and ends with a teacher check.
    </p>
    <p class="cta-row">
      <a class="button" href="/edubuilds/prompts/">Open the prompt library</a>
      <a class="button secondary" href="/edubuilds/Educator_AI_Master_Prompts.xlsx" download>Download the spreadsheet</a>
    </p>

    <h2>Write like a person</h2>
    <p>
      Anything students, families or colleagues will read gets a style pass first. The
      <a href="/library/tone-and-voice-style-guide-for-educators/">tone and voice style guide for educators</a>
      is the file the setup prompts call for by name. Fill in the Make it yours table, then
      upload it to your Project.
    </p>

    <h2>Downloads</h2>
    <ul>
      <li><a href="/edubuilds/Teaching-Thought-Partner-Prompts.pdf">Teaching thought partner prompts (PDF)</a>, the Quick Start and the Teaching Profile</li>
      <li><a href="/edubuilds/Tone-and-Voice-Style-Guide-for-Educators.pdf">Tone and voice style guide for educators (PDF)</a></li>
      <li><a href="/edubuilds/Educator_AI_Master_Prompts.xlsx" download>Educator AI master prompts (.xlsx)</a>, all 54 prompts with a reading view</li>
    </ul>
  </article>

  <article class="prose section">
    <h2>Getting an account</h2>
    <p>
      If you teach K-12 in the United States,
      <a href="https://www.anthropic.com/news/claude-for-teachers" rel="noopener">Claude for Teachers</a>
      and
      <a href="https://openai.com/index/chatgpt-for-teachers/" rel="noopener">ChatGPT for Teachers</a>
      are free individual sign-ups for verified educators, and your school doesn't need to
      enroll. Check your district's guidance on approved tools before you build, and keep
      student data out of all of them (the setup guide covers how).
    </p>

    <div class="draft-note">
      The slide deck will be added here once it's final.
    </div>

    <h2>Bring this to your school</h2>
    <p>
      <a href="/contact/">Get in touch</a> if you'd like to run this with your staff, and
      <a href="/contribute/">send in</a> a build that survived your own classroom.
    </p>
  </article>
</Base>

<style>
  .kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brick);
    margin: 0 0 0.35rem;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.25rem 0 0.5rem;
  }
  .prose-note {
    color: var(--ink-soft);
    margin: 0 0 1.1rem;
  }
  .cases {
    display: grid;
    gap: 1.25rem;
  }
  .case h3 {
    margin-bottom: 0.9rem;
  }
  .case dl {
    display: grid;
    grid-template-columns: minmax(9rem, 12rem) 1fr;
    gap: 0.5rem 1.25rem;
    margin: 0;
  }
  .case dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-top: 0.2rem;
  }
  .case dd {
    margin: 0;
    font-size: var(--text-sm);
    max-width: var(--measure);
  }
  .case dd ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .case dd li + li {
    margin-top: 0.25rem;
  }
  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
  }
  @media (max-width: 560px) {
    .case dl {
      grid-template-columns: 1fr;
      gap: 0.15rem 0;
    }
    .case dd {
      margin-bottom: 0.6rem;
    }
  }
</style>
